# 운영 EC2의 /opt/paldo-gotgan/.env 예시. 복사 후 값을 채우고 chmod 600 .env
# compose.prod.yml이 이 파일을 읽는다. 앱에 넘기는 값은 compose.prod.yml의 app.environment에 정해져 있다

# 앱 이미지 태그. 롤백할 때만 이전 커밋 SHA로 바꾼다
APP_IMAGE_TAG=latest

MYSQL_VERSION=9.4
MYSQL_DATABASE=paldogotgan
MYSQL_USER=paldogotgan
# 운영용 비밀번호: openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis 클러스터 노드 6대(마스터 3 + 복제본 3, #366)가 같은 버전·비밀번호를 쓴다. 올릴 때는 deploy.sh가 노드를 1대씩 다시 띄운다
REDIS_VERSION=8.10
# 필수. 비어 있으면 compose가 실패한다: openssl rand -base64 24
# 직접 정할 때는 영문·숫자·+/=만 쓴다. ", \, $가 있으면 Redis 설정 파일이 깨져 redis 노드가 재시작을 반복하고 app도 뜨지 않는다
# 노드 6대가 모두 같은 값을 써야 복제본이 마스터에 붙는다. 이미 클러스터가 있는 서버에서 바꾸면 노드를 모두 다시 띄워야 하므로 처음에 정한다
REDIS_PASSWORD=

# Kafka 브로커 3대 (#318). 둘 다 필수이고 비어 있으면 compose가 실패한다
# - 이미지 버전. 앱의 kafka-clients 버전(4.2.1)과 같은 숫자로 맞춘다. 올릴 때는 deploy.sh가 브로커를 1대씩 다시 띄운다
KAFKA_VERSION=4.2.1
# - 3대를 한 클러스터로 묶는 ID. 서버를 처음 만들 때 한 번 만들고 바꾸지 않는다 (바꾸면 브로커가 뜨지 않음, docs/DEPLOY.md)
#   생성: docker run --rm apache/kafka:4.2.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

APP_TIME_ZONE=Asia/Seoul
PROBLEM_BASE_URI=about:blank

# S3는 EC2 인스턴스 역할로 접근한다. AWS_ACCESS_KEY_ID·AWS_SECRET_ACCESS_KEY는 넣지 않는다
AWS_REGION=ap-northeast-2
S3_BUCKET=

TOSS_SECRET_KEY=
JEV_API_KEY=

# 최초 관리자 계정. 비워 두면 만들지 않는다
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
