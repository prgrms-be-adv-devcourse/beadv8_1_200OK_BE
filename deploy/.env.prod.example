# 운영 EC2의 /opt/paldo-gotgan/.env 예시. 복사 후 값을 채우고 chmod 600 .env
# compose.prod.yml이 이 파일을 읽는다. 앱에 넘기는 값은 compose.prod.yml의 app.environment에 정해져 있다

# 앱 이미지 태그. 롤백할 때만 이전 커밋 SHA로 바꾼다
APP_IMAGE_TAG=latest

MYSQL_VERSION=9.4
MYSQL_DATABASE=paldogotgan
MYSQL_USER=paldogotgan
# 운영용 비밀번호: openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

APP_TIME_ZONE=Asia/Seoul
PROBLEM_BASE_URI=about:blank

# S3는 EC2 인스턴스 역할로 접근한다. AWS_ACCESS_KEY_ID·AWS_SECRET_ACCESS_KEY는 넣지 않는다
AWS_REGION=ap-northeast-2
S3_BUCKET=

TOSS_SECRET_KEY=

# 최초 관리자 계정. 비워 두면 만들지 않는다
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
