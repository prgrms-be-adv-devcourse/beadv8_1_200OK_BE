# 운영 EC2의 /opt/paldo-gotgan/.env 예시. 복사 후 값을 채우고 chmod 600 .env
# compose.prod.yml이 이 파일을 읽는다. 앱에 넘기는 값은 compose.prod.yml의 app.environment에 정해져 있다

# 앱 이미지 태그. 롤백할 때만 이전 커밋 SHA로 바꾼다
APP_IMAGE_TAG=latest

MYSQL_VERSION=9.4
MYSQL_DATABASE=paldogotgan
MYSQL_USER=paldogotgan
# 운영용 비밀번호: openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_VERSION=8.10
# 필수. 비어 있으면 compose가 실패한다: openssl rand -base64 24
# 직접 정할 때는 영문·숫자·+/=만 쓴다. ", \, $가 있으면 Redis 설정 파일이 깨져 redis가 재시작을 반복하고 app도 뜨지 않는다
REDIS_PASSWORD=

# Kafka 구성 (#530). single(브로커 1대, 기본)과 cluster(브로커 3대) 중 하나만 켠다
# - 비우면 deploy.sh가 single로 둔다. single과 cluster를 함께 쓰거나 둘 다 빼면 deploy.sh가 거부한다
# - cluster로 바꾸면 아래 KAFKA_INTERNAL_BOOTSTRAP_SERVERS도 함께 넣는다(docs/DEPLOY.md)
COMPOSE_PROFILES=single
# KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# Kafka (#318). 둘 다 필수이고 비어 있으면 compose가 실패한다
# - 이미지 버전. 앱의 kafka-clients 버전(4.2.1)과 같은 숫자로 맞춘다. cluster는 올릴 때 deploy.sh가 브로커를 1대씩 다시 띄우고, single은 다시 만드는 동안 Kafka가 잠시 멈춘다
KAFKA_VERSION=4.2.1
# - 브로커를 한 클러스터로 묶는 ID. 서버를 처음 만들 때 한 번 만들고 바꾸지 않는다 (바꾸면 브로커가 뜨지 않음, docs/DEPLOY.md)
#   single과 cluster가 같은 값을 쓴다(볼륨이 따로라 서로 영향이 없다)
#   생성: docker run --rm apache/kafka:4.2.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=

# 모니터링 (#374). 둘 다 필수이고 비어 있으면 compose가 실패한다. 기존 서버는 배포 전에 .env에 추가해야 한다 (docs/DEPLOY.md 11절)
# - Grafana 로그인(admin / 이 값). Grafana DB가 처음 만들어질 때만 쓰인다: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# - mysqld-exporter 전용 DB 계정의 비밀번호. 영문·숫자·+/=_- 만 쓴다(SQL·설정 파일에 그대로 들어가므로 따옴표·백슬래시·$ 금지)
#   배포 뒤 monitoring/create-exporter-user.sh를 실행해 이 값으로 계정을 만든다: openssl rand -base64 24
MYSQL_EXPORTER_PASSWORD=

APP_TIME_ZONE=Asia/Seoul
PROBLEM_BASE_URI=about:blank

# S3는 EC2 인스턴스 역할로 접근한다. AWS_ACCESS_KEY_ID·AWS_SECRET_ACCESS_KEY는 넣지 않는다
AWS_REGION=ap-northeast-2
S3_BUCKET=

TOSS_SECRET_KEY=
JEV_API_KEY=

# 최초 관리자 계정. 비워 두면 만들지 않는다
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
