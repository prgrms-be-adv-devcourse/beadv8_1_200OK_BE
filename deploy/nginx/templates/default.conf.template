# 외부에는 /api/v1/**과 /bff/**만 공개한다. 내부 API(/internal), actuator, swagger는 존재를 드러내지 않도록 404로 막는다
# nginx 이미지가 시작할 때 envsubst로 /etc/nginx/conf.d/default.conf를 만든다. 치환 대상은 compose의 NGINX_ENVSUBST_FILTER로 API_UPSTREAM 하나만 둔다
server {
    listen 80 default_server;
    server_name _;

    # 404 응답 등에 nginx 버전을 드러내지 않기 위함이다
    server_tokens off;

    # 앱의 multipart 제한(30MB)보다 약간 크게 잡는다. 업로드 크기 오류는 nginx가 아니라 앱이 판단하게 하기 위함이다
    client_max_body_size 32m;

    # nginx는 proxy_pass 호스트를 시작할 때 한 번만 조회한다.
    # 배포로 app·bff 컨테이너가 다시 만들어지면 IP가 바뀌어 502가 나므로, docker 내장 DNS로 다시 조회한다.
    # 변수로 두면 bff가 없거나 죽어 있어도 nginx는 뜨고, 그 경로만 502가 난다
    resolver 127.0.0.11 valid=10s ipv6=off;
    # /api/v1/을 앱으로 바로 보낼지 BFF를 거칠지 .env의 API_UPSTREAM으로 고른다 (docs/DEPLOY.md 9절)
    set $api_upstream ${API_UPSTREAM};
    set $bff_upstream http://bff:8787;

    # location 안에 proxy_set_header를 따로 두면 아래 값이 상속되지 않는다. 헤더를 바꿀 때는 여기서만 바꾼다
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/v1/ {
        # URI 없이 변수만 쓰면 클라이언트가 보낸 경로가 그대로 전달된다
        proxy_pass $api_upstream;
        # API_UPSTREAM을 BFF로 돌리면 업로드도 BFF를 거친다. 대상이 바뀌어도 끊기지 않게 /bff/와 같은 값을 둔다
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }

    location /bff/ {
        proxy_pass $bff_upstream;
        # BFF가 업로드를 최대 120초 기다린다. 기본값(60초)이면 nginx가 먼저 끊으므로 여유를 둔다
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
    }

    location /internal/ {
        return 404;
    }

    location / {
        return 404;
    }
}
