# 이 파일을 .env로 복사해서 사용 (cp .env.example .env)
# 값을 지정하지 않으면 기본값이 사용됨

MYSQL_VERSION=9.4
MYSQL_PORT=3306
MYSQL_DATABASE=paldogotgan
MYSQL_USER=myuser
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=secretpassword

# Redis 클러스터 (#366). 로컬 compose가 노드 6대(마스터 3 + 복제본 3)를 띄운다(Docker 메모리 약 1GB)
REDIS_VERSION=8.10
# 앱이 접속할 클러스터 노드 목록. 이 줄을 주석으로 두거나 지우면 로컬 compose 노드(redis-1.localhost:7001 ~ redis-6.localhost:7006)를 쓴다
# 주의: `REDIS_CLUSTER_NODES=`처럼 빈 값으로 두면 기본값이 적용되지 않아 앱이 기동에 실패한다
# 노드 포트(7001~7006)는 노드가 클라이언트에게 알리는 주소와 같아야 해서 바꿀 수 없다
# *.localhost가 127.0.0.1로 풀리지 않는 환경(일부 Linux·Windows)에서는 hosts 파일에 redis-1.localhost ~ redis-6.localhost를 127.0.0.1로 추가한다
# REDIS_CLUSTER_NODES=redis-1.localhost:7001,redis-2.localhost:7002,redis-3.localhost:7003,redis-4.localhost:7004,redis-5.localhost:7005,redis-6.localhost:7006
# 로컬 Redis는 비밀번호 없이 뜨므로 비워 둔다
REDIS_PASSWORD=

# Kafka (#318). 로컬 compose가 브로커 3대를 띄운다(Docker 메모리 약 2GB)
# - 이미지 버전은 앱의 kafka-clients 버전(Spring Boot가 관리, 4.2.1)과 같은 숫자로 맞춘다
KAFKA_VERSION=4.2.1
# - Kafka 지표 수집 이미지 버전 (#396). docker compose --profile monitoring 으로 띄울 때만 쓴다
KAFKA_EXPORTER_VERSION=v1.11.0
# - 내 PC에서 브로커에 붙는 포트. 127.0.0.1에만 열린다
KAFKA_1_PORT=19092
KAFKA_2_PORT=29092
KAFKA_3_PORT=39092
# - 앱을 내 PC에서 실행할 때 접속할 브로커 3대. 위 포트를 바꾸면 여기도 같이 바꾼다
# - 비워 두거나 지워도 같은 값이 기본값이다. 컨테이너로 띄운 앱은 compose가 kafka-1:9092,... 로 덮는다
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
# - 컨슈머 그룹 ID. 정하지 않으면 앱 이름(monolith는 paldo-gotgan, 모듈 단독 실행은 모듈 이름)을 쓴다
#   같은 그룹끼리는 메시지를 나눠 받고, 그룹이 다르면 각자 모두 받는다
#   빈 값으로 두면 그룹 ID가 비어 버리므로, 바꿀 때만 주석을 풀고 값을 넣는다
# KAFKA_CONSUMER_GROUP_ID=paldo-gotgan

# docker compose 로 실행하는 앱 컨테이너의 호스트 포트
APP_PORT=8080

# 앱 실행 시 docker compose 자동 기동/종료 (dev 프로파일, 기본값 false)
DOCKER_COMPOSE_ENABLED=false

# 앱 실행 시 배치 Job 자동 실행 (dev 프로파일, 운영은 true 고정)
BATCH_JOB_ENABLED=false

# Modulith 재시작 시 미완료 이벤트 재발행 (dev 프로파일, 운영은 true 고정)
MODULITH_REPUBLISH_ON_RESTART=false

# Hibernate ddl-auto (dev 프로파일, 운영은 validate 고정)
JPA_DDL_AUTO=validate

# 타임존 (JDBC, Hibernate, Jackson, MySQL 컨테이너 공통) - 팀 기준 Asia/Seoul (#93)
# 이 파일을 복사해 .env 를 만들면 이 값이 기본값을 덮어쓰므로 팀 기준과 같게 둔다
APP_TIME_ZONE=Asia/Seoul

# 오류 응답(ProblemDetail)의 type 주소 접두사. about:blank 이면 type 을 about:blank 로 둔다
# 오류 문서 페이지가 생기면 해당 주소로 변경 (예: https://docs.example.com/problems/)
PROBLEM_BASE_URI=about:blank

# aws sdk
AWS_REGION=ap-northeast-2
S3_BUCKET=s3-bucket-name
AWS_ACCESS_KEY_ID=발급받은-access-key
AWS_SECRET_ACCESS_KEY=발급받은-secret-key

# JWT (RS256)
# - 서명용 개인키와 검증용 공개키를 PEM 파일로 저장소 루트의 keys/에 둔다. 이 폴더는 .gitignore에 들어 있다.
# - 파일 이름은 키 식별자(kid)를 따른다: keys/rs256-v1-private.pem, keys/rs256-v1-public.pem
# - 로컬 키는 각자 생성해 사용. 개발·운영 서버는 서로 다른 키를 사용.
# - 생성 (저장소 루트에서):
#     mkdir -p keys
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/rs256-v1-private.pem
#     openssl pkey -in keys/rs256-v1-private.pem -pubout -out keys/rs256-v1-public.pem
# - 운영 서버는 이 위치를 쓰지 않고 서버 키 폴더의 jwt.yaml로 키를 지정한다 (docs/DEPLOY.md 9절)

# 토스페이먼츠
# - 토스페이먼츠 개발자센터의 테스트 시크릿 키(test_sk_로 시작) 사용
# - 시크릿 키는 서버에서만 쓰고 프론트에 노출하지 않는다
TOSS_SECRET_KEY=test_sk_발급받은-테스트-시크릿-키

# 최초 관리자 계정 (앱 시작 시 생성)
# - 아이디를 비워 두면 만들지 않는다(기본). 아이디를 넣으면 비밀번호·이메일도 넣어야 앱이 시작된다
# - 같은 아이디의 회원이 이미 있으면 만들지 않고 비밀번호도 바꾸지 않는다
# - 아이디: 영문 소문자·숫자 4~20자 / 비밀번호: 영문·숫자·특수문자 포함 8~20자
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
