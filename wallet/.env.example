# wallet 모듈 단독 실행용 DB 계정. ./infra/mysql/sync-module-users.sh --init 이 이 파일에서 .env를 만들고 MySQL에 같은 계정을 만든다
DB_USERNAME=paldogotgan_wallet
DB_PASSWORD=

# 토스페이먼츠 시크릿 키. 토스페이먼츠 개발자센터의 테스트 시크릿 키(test_sk_로 시작)를 아래 = 뒤에 넣는다
# = 뒤를 비워 두면 루트 .env에 키가 있어도 이 빈 값이 쓰여 앱이 시작되지 않는다. 서버에서만 쓰고 저장소와 프론트에 두지 않는다
TOSS_SECRET_KEY=
