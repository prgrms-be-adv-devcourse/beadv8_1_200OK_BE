meta {
  name: 준비 - 리뷰 쓸 상품 등록
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

headers {
  X-Member-Id: 7
  X-Member-Role: SELLER
}

body:json {
  {
    "name": "Bruno 리뷰 테스트 사과",
    "descriptionHtml": "<p>리뷰 API 테스트용 상품</p>",
    "category": "FRUIT",
    "region": "GYEONGBUK",
    "status": "ON_SALE",
    "visibility": "VISIBLE",
    "imageUrls": ["https://{{process.env.S3_BUCKET}}.s3.{{process.env.AWS_REGION}}.amazonaws.com/product/bruno-sample.jpg"],
    "options": [
      { "name": "3kg 특품", "listPrice": 40000, "salePrice": 32000, "totalStock": 10 }
    ]
  }
}

assert {
  res.status: eq 201
  res.body.productId: isNumber
}

script:post-response {
  bru.setVar("reviewProductId", res.body.productId);
}
