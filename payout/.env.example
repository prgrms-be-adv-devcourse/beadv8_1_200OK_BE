# payout 모듈 단독 실행용 DB 계정. ./infra/mysql/sync-module-users.sh --init 이 이 파일에서 .env를 만들고 MySQL에 같은 계정을 만든다
DB_USERNAME=paldogotgan_payout
DB_PASSWORD=

# 앱 시작 시 배치 Job 자동 실행. 켜지 않는다 (#245)
# true로 켜면 파라미터 없이 실행되어 Job 시작 전 검사(#485)에 걸려 앱이 시작되지 않는다. 정산은 스케줄러와 관리자 API로 실행한다
BATCH_JOB_ENABLED=false

# 대기 건너뛰기 실행(POST /api/v1/admin/payouts/run/skip-wait) 스위치 (#485)
# 로컬·발표에서 바로 쓰려고 켜 둔다
PAYOUT_SKIP_WAIT_RUN_ENABLED=true
